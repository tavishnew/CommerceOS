[TEMPLATE]
# Neon Postgres connection string (same DB the Python agents use)
DATABASE_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/dbname?sslmode=require

# FastAPI service URLs for health checks
SUPPLIER_URL=http://localhost:8080
RETAILER_URL=http://localhost:8082

# Server port
PORT=5000

# Razorpay TEST mode keys — NEVER use live keys here
# Get these from https://dashboard.razorpay.com/app/keys (test mode)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here
