# Commerce0S web app environment
# Copy this file to .env.local (gitignored) and edit values per environment.
# `pnpm dev` and `pnpm build` both read VITE_* vars from .env / .env.local /
# the calling shell. Vite embeds VITE_* into the client JS at build time.

# Local development: hit the API on localhost.
VITE_API_URL=http://localhost:5000

# Shared demo / ngrok:
#   1. Run `ngrok http 5000` against the API and copy the printed HTTPS origin.
#   2. Set VITE_API_URL=https://<API-NGROK-URL> here.
#   3. Restart `pnpm dev` (or rebuild) so the new origin is embedded.
#   4. Set FRONTEND_ORIGIN=https://<FRONTEND-NGROK-URL> on the API to allow CORS.