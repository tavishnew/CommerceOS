# Commerce0S API server environment
# Copy this file to .env and fill in real values.

# Database
DATABASE_URL=postgres://user:pass@host:5432/dbname

# External services (optional)
SUPPLIER_URL=http://localhost:8080
RETAILER_URL=http://localhost:8082

# Encryption key for at-rest merchant secrets (Razorpay key/secret/webhook).
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# It must be at least 16 chars; a 64-char hex string is recommended.
ENCRYPTION_KEY=

# Razorpay TEST mode fallback (optional, local dev only).
# In production, prefer configuring per-merchant credentials via
# the Settings → Payment gateway UI. These values are only used
# when no merchant_credentials row exists yet.
# Test mode keys always start with rzp_test_
RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXXXXXXXX
RAZORPAY_KEY_SECRET=XXXXXXXXXXXXXXXX
RAZORPAY_WEBHOOK_SECRET=XXXXXXXXXXXXXXXX

# IMPORTANT: never use live/production keys in this environment.
# Live keys start with rzp_live_ and must NOT be used here.

# CORS allowlist extension. Comma-separated list of additional origins allowed
# to call the API (browser Origin header). The hardcoded defaults remain
# http://localhost:5173 and http://127.0.0.1:5173. For ngrok-based sharing,
# prefer FRONTEND_ORIGIN (single value, matches the docs).
# FRONTEND_ORIGIN=https://<FRONTEND-NGROK-URL>
# CORS_EXTRA_ORIGINS=https://a.example.com,https://b.example.com