# Commerce0S API server environment
# Copy this file to .env and fill in real values.

# Database
DATABASE_URL=postgres://user:pass@host:5432/dbname

# External services (optional)
SUPPLIER_URL=http://localhost:8080
RETAILER_URL=http://localhost:8082

# Encryption key for at-rest merchant secrets (Razorpay key/secret/webhook).
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# It must be at least 16 chars; a 64-char hex string is recommended.
ENCRYPTION_KEY=

# Razorpay mode. Controls the runtime guard at boot:
#   - "test"  → RAZORPAY_KEY_ID must start with rzp_test_  (or be unset)
#   - "live"  → RAZORPAY_KEY_ID must start with rzp_live_  (required)
#   - "" / unset → no guard; uses whatever key id is present (legacy local-dev path)
# In production, prefer configuring per-merchant credentials via the
# Settings → Payment gateway UI. The values below are only used when no
# merchant_credentials row exists yet.
RAZORPAY_MODE=test
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# IMPORTANT: never use live/production keys in this environment.
# Live keys start with rzp_live_ and must NOT be used here.

# Rate-limit bypass (independent of Razorpay mode).
# Set to 1 to disable every rate limiter — useful for automated tests
# and load demos. Has no effect on Razorpay behaviour.
# DISABLE_RATE_LIMITS=0

# CORS allowlist extension. Comma-separated list of additional origins allowed
# to call the API (browser Origin header). The hardcoded defaults remain
# http://localhost:5173 and http://127.0.0.1:5173. For ngrok-based sharing,
# prefer FRONTEND_ORIGIN (single value, matches the docs).
# FRONTEND_ORIGIN=https://<FRONTEND-NGROK-URL>
# CORS_EXTRA_ORIGINS=https://a.example.com,https://b.example.com